# See: https://www.nginx.com/resources/wiki/start/topics/recipes/wordpress/

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};
    root ${NGINX_ROOT};
    index index.php;

    gzip on;
    gzip_disable "msie6";
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types
        application/javascript
        application/json
        application/rss+xml
        application/xml
        image/svg+xml
        text/css
        text/javascript
        text/plain
        text/xml;

    client_max_body_size 8G;

    # Reuse theme path
    set $theme_root /app/themes/murr;

    location = /favicon.ico {
        try_files $uri $theme_root/public/images/favicon.ico =404;
        access_log off;
        log_not_found off;
    }

    location = /favicon.svg {
        try_files $uri $theme_root/public/images/favicon.svg =404;
        access_log off;
        log_not_found off;
    }

    location ~ ^/((?:favicon-(?:16x16|32x32)|apple-touch-icon(?:-180x180)?|android-chrome-(?:192x192|512x512))\.png)$ {
        try_files $uri $theme_root/public/images/$1 =404;
        access_log off;
        log_not_found off;
    }

    location = /site.webmanifest {
        try_files $uri $theme_root/public/images/site.webmanifest =404;
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        allow all;
        log_not_found off;
        access_log off;
    }

    location / {
        try_files $uri $uri/ /index.php?$args;
    }

    location ~* \.(?:css|js|jpe?g|png|gif|ico|webp|avif|svg|mp4|webmanifest)$ {
        expires 365d;
        add_header Cache-Control "public, max-age=31536000, immutable";
        access_log off;
    }

    location ^~ /app/uploads/ {
        expires 30d;
        add_header Cache-Control "public, max-age=2592000, immutable";
        access_log off;
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include fastcgi_params;
        fastcgi_intercept_errors on;
        fastcgi_pass ${FPM_HOST}:9000;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }

    location ~* \.(eot|ttf|woff|woff2)$ {
        add_header Access-Control-Allow-Origin *;
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        access_log off;
    }
}
