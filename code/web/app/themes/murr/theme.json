{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "settings": {
        "appearanceTools": true,
        "border": {
            "color": false,
            "radius": false,
            "style": false,
            "width": false
        },
        "color": {
            "custom": false,
            "customGradient": false,
            "defaultPalette": false,
            "customDuotone": false,
            "defaultGradients": false,
            "palette": [
                {
                    "slug": "background",
                    "color": "var(--background)",
                    "name": "Background"
                },
                {
                    "slug": "foreground",
                    "color": "var(--foreground)",
                    "name": "Foreground"
                },
                {
                    "slug": "primary",
                    "color": "var(--primary)",
                    "name": "Brand Primary"
                },
                {
                    "slug": "secondary",
                    "color": "var(--secondary)",
                    "name": "Brand Secondary"
                },
                {
                    "slug": "secondary-light",
                    "color": "var(--secondary-light)",
                    "name": "Brand Secondary Light"
                },
                {
                    "slug": "tertiary",
                    "color": "var(--tertiary)",
                    "name": "Tertiary"
                },
                {
                    "slug": "quaternary",
                    "color": "var(--quaternary)",
                    "name": "Quaternary"
                }
            ]
        },
        "typography": {
            "customFontSize": false,
            "fontWeight": false,
            "fluid": true,
            "letterSpacing": false,
            "lineHeight": true,
            "dropCap": false,
            "defaultFontSizes": false,
            "fontFamilies": [
                {
                    "fontFamily": "Georgia, serif",
                    "name": "Georgia",
                    "slug": "georgia"
                },
                {
                    "fontFamily": "Verdana, sans-serif",
                    "name": "Verdana",
                    "slug": "verdana"
                },
                {
                    "fontFamily": "\"Montserrat\", sans-serif",
                    "name": "Montserrat",
                    "slug": "montserrat",
                    "fontFace": [
                        {
                            "fontDisplay": "swap",
                            "fontFamily": "Montserrat",
                            "fontStyle": "normal",
                            "fontWeight": "400 800",
                            "src": ["file:./resources/fonts/Montserrat-VariableFont_wght.woff", "file:./resources/fonts/Montserrat-VariableFont_wght.woff2"]
                        },
                        {
                            "fontDisplay": "swap",
                            "fontFamily": "Montserrat",
                            "fontStyle": "italic",
                            "fontWeight": "400 800",
                            "src": ["file:./resources/fonts/Montserrat-Italic-VariableFont_wght.woff", "file:./resources/fonts/Montserrat-Italic-VariableFont_wght.woff2"]
                        }
                    ]
                },
                {
                    "fontFamily": "\"Open Sans\", sans-serif",
                    "name": "Open Sans",
                    "slug": "open-sans",
                    "fontFace": [
                        {
                            "fontDisplay": "swap",
                            "fontFamily": "Open Sans",
                            "fontStyle": "normal",
                            "fontWeight": "400 800",
                            "src": ["file:./resources/fonts/OpenSans-VariableFont_wght.woff", "file:./resources/fonts/OpenSans-VariableFont_wght.woff2"]
                        },
                        {
                            "fontDisplay": "swap",
                            "fontFamily": "Open Sans",
                            "fontStyle": "italic",
                            "fontWeight": "400 800",
                            "src": ["file:./resources/fonts/OpenSans-Italic-VariableFont_wght.woff", "file:./resources/fonts/OpenSans-Italic-VariableFont_wght.woff2"]
                        }
                    ]
                }
            ],
            "fontSizes": [
                {
                    "slug": "micro",
                    "size": "0.75rem",
                    "name": "Micro",
                    "fluid": false
                },
                {
                    "slug": "mini",
                    "size": "0.875rem",
                    "name": "Mini",
                    "fluid": false
                },
                {
                    "slug": "small",
                    "size": "1rem",
                    "name": "Small",
                    "fluid": false
                },
                {
                    "slug": "medium",
                    "size": "1.125rem",
                    "name": "Medium",
                    "fluid": false
                },
                {
                    "slug": "big",
                    "size": "1.25rem",
                    "name": "Big",
                    "fluid": false
                },
                {
                    "slug": "huge",
                    "size": "1.5rem",
                    "name": "Huge",
                    "fluid": false
                },
                {
                    "slug": "large",
                    "size": "2rem",
                    "name": "Large",
                    "fluid": false
                },
                {
                    "slug": "x-large",
                    "size": "2.5rem",
                    "name": "X-large",
                    "fluid": false
                },
                {
                    "size": "3rem",
                    "slug": "xx-large",
                    "name": "XX-Large",
                    "fluid": {
                        "min": "3rem",
                        "max": "3.125rem"
                    }
                }
            ]
        },
        "custom": {
            "color": {
                "link": "var(--secondary)"
            },
            "font-size": {
                "button-default": "var(--wp--preset--font-size--medium)",
                "button-micro": "var(--wp--preset--font-size--small)"
            },
            "forms": {
                "background": "var(--form-bg-color)",
                "border-color": "var(--secondary)",
                "border-radius": "2px",
                "border-width": "1px",
                "error-color": "#FF0000",
                "font-size": "var(--wp--preset--font-size--mini)",
                "input-padding-vertical": "1rem",
                "input-padding-horizontal": "1.125rem",
                "required-color": "#FF0000",
                "spacing": "2rem"
            },
            "layout": {
                "post": "856px"
            },
            "line-height": {
                "tiny": 1,
                "small": 1.125,
                "normal": 1.25,
                "medium": 1.5
            },
            "spacing": {
                "base-padding": "2rem",
                "block-gap": "1.5rem",
                "block-gap-large": "3rem",
                "block-gap-small": ".5rem",
                "column-gap": "1.5rem",
                "column-gap-large": "2rem",
                "column-gap-huge": "4.5rem",
                "grid-gap-1": "1.25rem",
                "grid-gap-2": "2.5rem",
                "grid-gap-3": "3rem",
                "grid-gap-4": "5rem",
                "grid-gap-5": "12rem",
                "grid-gap-row": "2rem",
                "grid-gap-row-large": "3rem",
                "group-padding-1": "5rem",
                "group-padding-2": "3.5rem",
                "group-padding-3": "2rem",
                "list-gap-bottom": "0.75rem",
                "viewport-padding": "1.5rem",
                "viewport-padding-mobile": "1.25rem"
            }
        },
        "layout": {
            "contentSize": "62rem",
            "wideSize": "90rem"
        },
        "spacing": {
            "blockGap": true,
            "customSpacingSize": false,
            "defaultSpacingSizes": false,
            "spacingSizes": [
                {
                    "slug": "10",
                    "size": "0.5rem",
                    "name": "Spacing 100"
                },
                {
                    "slug": "15",
                    "size": "clamp(0.625rem, 0.2381vw + 0.5357rem, 0.75rem)",
                    "name": "Spacing 150"
                },
                {
                    "slug": "20",
                    "size": "clamp(0.75rem, 0.4762vw + 0.5714rem, 1rem)",
                    "name": "Spacing 200"
                },
                {
                    "slug": "25",
                    "size": "clamp(1rem, 0.4762vw + 0.8214rem, 1.25rem)",
                    "name": "Spacing 250"
                },
                {
                    "slug": "30",
                    "size": "clamp(1rem, 0.9524vw + 0.6429rem, 1.5rem)",
                    "name": "Spacing 300"
                },
                {
                    "slug": "40",
                    "size": "clamp(1.25rem, 1.429vw + 0.7143rem, 2rem)",
                    "name": "Spacing 400"
                },
                {
                    "slug": "50",
                    "size": "clamp(1.5rem, 1.905vw + 0.7857rem, 2.5rem)",
                    "name": "Spacing 500"
                },
                {
                    "slug": "60",
                    "size": "clamp(1.75rem, 2.381vw + 0.8571rem, 3rem)",
                    "name": "Spacing 600"
                },
                {
                    "slug": "70",
                    "size": "clamp(2rem, 2.857vw + 0.9286rem, 3.5rem)",
                    "name": "Spacing 700"
                },
                {
                    "slug": "80",
                    "size": "clamp(2.5rem, 2.857vw + 1.429rem, 4rem)",
                    "name": "Spacing 800"
                },
                {
                    "slug": "90",
                    "size": "clamp(3rem, 2.857vw + 1.929rem, 4.5rem)",
                    "name": "Spacing 900"
                },
                {
                    "slug": "100",
                    "size": "clamp(3.5rem, 2.857vw + 2.429rem, 5rem)",
                    "name": "Spacing 1000"
                }
            ],
            "units": ["px", "rem", "vh", "vw"]
        },
        "blocks": {
            "core/button": {
                "color": {
                    "text": false,
                    "palette": [
                        {
                            "slug": "primary-btn",
                            "color": "var(--primary-btn)",
                            "name": "Button Primary"
                        },
                        {
                            "slug": "secondary-btn",
                            "color": "var(--secondary-btn)",
                            "name": "Button Secondary"
                        }
                    ]
                }
            },
            "core/group": {
                "color": {
                    "background": true
                },
                "spacing": {
                    "padding": true
                }
            }
        }
    },
    "styles": {
        "color": {
            "background": "var(--background)",
            "text": "var(--foreground)"
        },
        "typography": {
            "fontFamily": "var:preset|font-family|open-sans",
            "fontSize": "var(--wp--preset--font-size--medium)",
            "lineHeight": "var(--wp--custom--line-height--medium)"
        },
        "elements": {
            "button": {
                "typography": {
                    "fontFamily": "var:preset|font-family|montserrat",
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "heading": {
                "color": {
                    "text": "var(--primary)"
                },
                "typography": {
                    "fontFamily": "var:preset|font-family|montserrat",
                    "fontWeight": "800",
                    "lineHeight": "var(--wp--custom--line-height--tiny)"
                }
            },
            "h1": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--x-large)"
                }
            },
            "h2": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--large)"
                }
            },
            "h3": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--huge)"
                }
            },
            "h4": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--big)"
                }
            },
            "h5": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--medium)"
                }
            },
            "h6": {
                "typography": {
                    "fontSize": "var(--wp--preset--font-size--small)"
                }
            },
            "link": {
                "color": {
                    "text": "var(--wp--custom--color--link)"
                }
            }
        },
        "spacing": {
            "blockGap": "var(--wp--custom--spacing--block-gap)"
        }
    }
}
