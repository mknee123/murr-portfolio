{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "murr/masthead",
    "title": "Masthead",
    "category": "mk-blocks",
    "description": "Full width background image or video",
    "keywords": ["image", "video", "masthead", "hero"],
    "version": "1.1.0",
    "textdomain": "murr",
    "attributes": {
        "backgrounds": {
            "type": "array",
            "default": []
        },
        "format": {
            "type": "string",
            "default": "image"
        },
        "includeOverlay": {
            "type": "boolean",
            "default": true
        },
        "overlayOpacity": {
            "type": "integer",
            "default": 40
        },
        "objectSize": {
            "type": "string",
            "default": "cover"
        },
        "objectPosition": {
            "type": "array",
            "default": ["center", "center"]
        },
        "embed": {
            "type": "boolean",
            "default": false
        },
        "embedCode": {
            "type": "string",
            "default": ""
        },
        "fallback": {
            "type": "object",
            "default": null
        }
    },
    "example": {},
    "viewScript": "file:./front.js",
    "editorScript": "file:./editor.js",
    "style": "file:./front.css",
    "render": "file:./index.php"
}
